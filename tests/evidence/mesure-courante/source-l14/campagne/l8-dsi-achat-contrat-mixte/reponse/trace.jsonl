{"source_event":100,"events":[{"type":"mcp_call","server":"droit-francais","tool":"get_article","status":"completed","succeeded":true,"arguments_publics":{"id":"LEGIARTI000037703841"},"identifiants_dans_resultat":["LEGIARTI000037703841"],"result_sha256":"2fbfd3e053369357e78e2b80732ba066c4044754076d2e951911d6e05325bee9","review_material":{"schema":"mcp-text-v1","untrusted_data":true,"tool":"get_article","arguments_present":true,"arguments":{"id":"LEGIARTI000037703841"},"arguments_sha256":"2ed6d0fb0ff82c01766672e4d3ab51a12ae507067b9b7b52ce8a0ec06cb1a854","text":"{\n  \"id\": \"LEGIARTI000037703841\",\n  \"title\": \"Article L2194-1\",\n  \"text\": \"Un marché peut être modifié sans nouvelle procédure de mise en concurrence dans les conditions prévues par voie réglementaire, lorsque : 1° Les modifications ont été prévues dans les documents contractuels initiaux ; 2° Des travaux, fournitures ou services supplémentaires sont devenus nécessaires ; 3° Les modifications sont rendues nécessaires par des circonstances imprévues ; 4° Un nouveau titulaire se substitue au titulaire initial du marché ; 5° Les modifications ne sont pas substantielles ; 6° Les modifications sont de faible montant. Qu'elles soient apportées par voie conventionnelle ou, lorsqu'il s'agit d'un contrat administratif, par l'acheteur unilatéralement, de telles modifications ne peuvent changer la nature globale du marché.\",\n  \"url\": \"https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000037703841\",\n  \"metadata\": {\n    \"number\": \"L2194-1\",\n    \"legal_status\": \"VIGUEUR\",\n    \"start_date\": 1554076800000,\n    \"end_date\": 32472144000000,\n    \"source\": \"Légifrance API\",\n    \"verified\": true,\n    \"content_trust\": \"untrusted_source_data\",\n    \"as_of_date\": \"2026-10-22\",\n    \"date_basis\": \"date du jour du serveur\",\n    \"requested_date\": null,\n    \"version_start_date\": \"2019-04-01\",\n    \"version_end_date\": \"2999-01-01\",\n    \"applicable_at_as_of_date\": true\n  }\n}","text_available":true,"text_block_count":1,"text_limit_bytes":12000,"included_text_bytes":1393,"included_text_sha256":"01eea8808a8dd2158df1ab13cec8fdfd0fe6e1145ba32b21d158edb4352925b6","full_text_bytes":1393,"full_text_sha256":"01eea8808a8dd2158df1ab13cec8fdfd0fe6e1145ba32b21d158edb4352925b6","truncated":false,"hash_scope":"all_text_blocks_observed_in_cli_event_joined_by_two_LF_UTF8","upstream_truncation":"not_attested"}}]}
