{"source_event":108,"events":[{"type":"mcp_call","server":"droit-francais","tool":"get_article","status":"completed","succeeded":true,"arguments_publics":{"id":"LEGIARTI000037703841"},"identifiants_dans_resultat":["LEGIARTI000037703841"],"result_sha256":"d5d92ee8860423c880879fd5af17ec419985b8780de0ca757c574485f47e2d3d","review_material":{"schema":"mcp-text-v1","untrusted_data":true,"tool":"get_article","arguments_present":true,"arguments":{"id":"LEGIARTI000037703841"},"arguments_sha256":"2ed6d0fb0ff82c01766672e4d3ab51a12ae507067b9b7b52ce8a0ec06cb1a854","text":"{\n  \"id\": \"LEGIARTI000037703841\",\n  \"title\": \"Article L2194-1\",\n  \"text\": \"Un marché peut être modifié sans nouvelle procédure de mise en concurrence dans les conditions prévues par voie réglementaire, lorsque : 1° Les modifications ont été prévues dans les documents contractuels initiaux ; 2° Des travaux, fournitures ou services supplémentaires sont devenus nécessaires ; 3° Les modifications sont rendues nécessaires par des circonstances imprévues ; 4° Un nouveau titulaire se substitue au titulaire initial du marché ; 5° Les modifications ne sont pas substantielles ; 6° Les modifications sont de faible montant. Qu'elles soient apportées par voie conventionnelle ou, lorsqu'il s'agit d'un contrat administratif, par l'acheteur unilatéralement, de telles modifications ne peuvent changer la nature globale du marché.\",\n  \"url\": \"https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000037703841\",\n  \"metadata\": {\n    \"number\": \"L2194-1\",\n    \"legal_status\": \"VIGUEUR\",\n    \"start_date\": 1554076800000,\n    \"end_date\": 32472144000000,\n    \"source\": \"Légifrance API\",\n    \"verified\": true,\n    \"content_trust\": \"untrusted_source_data\",\n    \"as_of_date\": \"2026-11-09\",\n    \"date_basis\": \"date du jour du serveur\",\n    \"requested_date\": null,\n    \"version_start_date\": \"2019-04-01\",\n    \"version_end_date\": \"2999-01-01\",\n    \"applicable_at_as_of_date